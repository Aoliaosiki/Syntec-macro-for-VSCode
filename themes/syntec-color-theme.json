    },
    {
      "scope": "string.xcode.gcode",
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "scope": "comment.type.ycode.gcode",
      "settings": { "foreground": "#DCDCAA" }
    },
    {
      "scope": "support.function.mcode.gcode",
      "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
    },
    {
      "scope": "support.type.dDfFhHsStTcode.gcode",
      "settings": { "foreground": "#4EC9B0" }
    },
    {
      "scope": "variable.parameter.pqecode.gcode",
      "settings": { "foreground": "#569CD6" }
    },
    {
      "scope": "string.control.mcode.gcode",
      "settings": { "foreground": "#569CD6" }
    },
    {
      "scope": "comment.gcode",
      "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
