      "scope": "keyword.control.syntec",
      "settings": { "foreground": "#C586C0", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.function.syntec",
      "settings": { "foreground": "#DCDCAA", "fontStyle": "bold" }
    },
    {
      "scope": "variable.other.syntec",
      "settings": { "foreground": "#9CDCFE", "fontStyle": "italic" }
    },
    {
      "scope": "keyword.operator.syntec",
      "settings": { "foreground": "#D4D4D4" }
    },
    {
      "scope": "punctuation.definition.statement.syntec",
      "settings": { "foreground": "#D4D4D4" }
    },
    {
      "scope": "support.function.syntec",
      "settings": { "foreground": "#DCDCAA", "fontStyle": "bold" }
    },
    {
      "scope": "constant.numeric.syntec",
      "settings": { "foreground": "#B5CEA8" }
    },
    {
      "scope": "constant.language.syntec",
      "settings": { "foreground": "#569CD6", "fontStyle": "bold" }
    },
    {
      "scope": "string.quoted.double.syntec",
      "settings": { "foreground": "#CE9178" }
    },
    {
      "scope": ["comment.line.double-slash.syntec", "comment.block.syntec"],
      "settings": { "foreground": "#6A9955", "fontStyle": "italic" }
    },
    {
      "scope": [
        "punctuation.definition.comment.begin.syntec",
        "punctuation.definition.comment.end.syntec",
        "punctuation.definition.string.begin.syntec",
        "punctuation.definition.string.end.syntec",
        "constant.character.escape.syntec"
      ],
      "settings": { "foreground": "#CE9178" }
